<Project Sdk="Microsoft.NET.Sdk">

  <!--
    RimTalk Toddlers Expansion (Add-on Mod)
    Build:
      dotnet build -c Release -p:GameVersion=1.7 -p:RimWorldDir="/path/to/RimWorld" -p:HarmonyAssemblyPath="/path/to/Harmony/1.7/Assemblies/0Harmony.dll" -p:ToddlersAssemblyPath="/path/to/Toddlers/1.6/Assemblies/Toddlers.dll"
    Output:
      <ModRoot>\<GameVersion>\Assemblies\RimTalk_ToddlersExpansion.dll
  -->

  <PropertyGroup>
    <!-- Defaults -->
    <GameVersion Condition=" '$(GameVersion)' == '' ">1.7</GameVersion>

    <TargetFramework Condition=" '$(GameVersion)' == '1.7' ">net10.0</TargetFramework>
    <TargetFramework Condition=" '$(GameVersion)' != '1.7' ">net48</TargetFramework>

    <RootNamespace>RimTalk_ToddlersExpansion</RootNamespace>
    <AssemblyName>RimTalk_ToddlersExpansion</AssemblyName>

    <!-- RimWorld mod layout: put DLL directly under mod root <GameVersion>/Assemblies -->
    <OutputPath>..\$(GameVersion)\Assemblies\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>

    <!-- VSCode/OmniSharp: do not fall back to C# 7.3 -->
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>

    <!-- Mod assemblies: keep outputs clean -->
    <DebugType>portable</DebugType>
    <Deterministic>true</Deterministic>

    <!-- Make it easier to evolve this add-on without blocking builds -->
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>

  <!-- Optional version defines for conditional compilation -->
  <PropertyGroup Condition=" '$(GameVersion)' == '1.5' ">
    <DefineConstants>$(DefineConstants);V1_5</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(GameVersion)' == '1.6' ">
    <DefineConstants>$(DefineConstants);V1_6</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(GameVersion)' == '1.7' ">
    <DefineConstants>$(DefineConstants);V1_7</DefineConstants>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <ItemGroup Condition=" '$(GameVersion)' != '1.7' ">
    <!-- Reference pack for RimWorld types (Verse/RimWorld/Unity) -->
    <PackageReference Include="Krafs.Rimworld.Ref" Version="$(GameVersion).*-*" PrivateAssets="All" />
    <!-- Harmony reference -->
    <PackageReference Include="Lib.Harmony.Ref" Version="2.*" PrivateAssets="All" />
  </ItemGroup>

  <ItemGroup Condition=" '$(GameVersion)' == '1.7' ">
    <!-- RimWorld 1.7 targets .NET 10 and is referenced from the installed game. -->
    <Reference Include="Assembly-CSharp" HintPath="$(RimWorldDir)/Assembly-CSharp.dll" Private="false" />
    <Reference Include="UnityStubs" HintPath="$(RimWorldDir)/UnityStubs.dll" Private="false" />
    <Reference Include="0Harmony" HintPath="$(HarmonyAssemblyPath)" Private="false" />
  </ItemGroup>

  <Target Name="CheckRimWorldReferences" BeforeTargets="ResolveReferences">
    <Error Condition="'$(GameVersion)' != '1.5' and '$(GameVersion)' != '1.6' and '$(GameVersion)' != '1.7'" Text="GameVersion must be 1.5, 1.6, or 1.7." />
    <Error Condition="'$(GameVersion)' == '1.7' and (!Exists('$(RimWorldDir)/Assembly-CSharp.dll') or !Exists('$(RimWorldDir)/UnityStubs.dll'))" Text="Set RimWorldDir to the RimWorld 1.7 game root containing Assembly-CSharp.dll and UnityStubs.dll." />
    <Error Condition="'$(GameVersion)' == '1.7' and !Exists('$(HarmonyAssemblyPath)')" Text="Set HarmonyAssemblyPath to Harmony's 1.7/Assemblies/0Harmony.dll." />
  </Target>

  <!-- RimTalk core reference: configurable location -->
  <PropertyGroup>
    <!-- Override on command line: -p:RimTalkDir=... -->
    <RimTalkDir Condition=" '$(RimTalkDir)' == '' ">..\..\RimTalk</RimTalkDir>
    <RimWorldDir Condition=" '$(RimWorldDir)' == '' ">$(RIMWORLD_DIR)</RimWorldDir>
    <HarmonyAssemblyPath Condition=" '$(HarmonyAssemblyPath)' == '' ">$(HarmonyModDir)/1.7/Assemblies/0Harmony.dll</HarmonyAssemblyPath>
    <ToddlersDir Condition=" '$(ToddlersDir)' == '' ">..\..\Toddlers</ToddlersDir>
    <ToddlersAssemblyName Condition=" '$(ToddlersAssemblyName)' == '' ">Toddlers</ToddlersAssemblyName>
    <ToddlersAssemblyPath Condition=" '$(ToddlersAssemblyPath)' == '' and Exists('$(ToddlersDir)/1.7/Assemblies/$(ToddlersAssemblyName).dll') ">$(ToddlersDir)/1.7/Assemblies/$(ToddlersAssemblyName).dll</ToddlersAssemblyPath>
    <ToddlersAssemblyPath Condition=" '$(ToddlersAssemblyPath)' == '' and Exists('$(ToddlersDir)/1.6/Assemblies/$(ToddlersAssemblyName).dll') ">$(ToddlersDir)/1.6/Assemblies/$(ToddlersAssemblyName).dll</ToddlersAssemblyPath>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="RimTalk" Condition="Exists('$(RimTalkDir)\$(GameVersion)\Assemblies\RimTalk.dll')">
      <!-- Expected layout: ..\..\RimTalk\<GameVersion>\Assemblies\RimTalk.dll -->
      <HintPath>$(RimTalkDir)\$(GameVersion)\Assemblies\RimTalk.dll</HintPath>
      <!-- Do not copy RimTalk.dll into this mod's Assemblies -->
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup Condition=" '$(GameVersion)' == '1.7' and Exists('$(ToddlersAssemblyPath)') ">
    <Reference Include="Toddlers" HintPath="$(ToddlersAssemblyPath)" Private="false" />
  </ItemGroup>

  <!-- Toddlers mod reference (optional): prefer reflection at runtime, but allow compile-time ref if available -->
  <PropertyGroup>
    <!-- Override on command line: -p:ToddlersDir=... or -p:ToddlersAssemblyName=... -->
  </PropertyGroup>

  <ItemGroup>
    <!-- Expected layout: ..\..\Toddlers\<GameVersion>\Assemblies\Toddlers.dll -->
    <Reference Include="Toddlers"
               Condition="Exists('$(ToddlersDir)\$(GameVersion)\Assemblies\$(ToddlersAssemblyName).dll')">
      <HintPath>$(ToddlersDir)\$(GameVersion)\Assemblies\$(ToddlersAssemblyName).dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- Prompt templates (optional): embed into the assembly to avoid file path issues -->
  <ItemGroup Condition="Exists('promptoverride')">
    <EmbeddedResource Include="promptoverride\templates\**\*.txt" />
  </ItemGroup>

</Project>
